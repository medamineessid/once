# Normalize text files to LF in the repository so WSL and Windows agree.
* text=auto eol=lf

# Windows-native scripts must keep CRLF to run correctly.
*.ps1 text eol=crlf
*.bat text eol=crlf

# Shell scripts must keep LF.
*.sh text eol=lf

# Binary assets: never convert, never diff.
*.ttf binary
*.otf binary
*.png binary
*.ico binary
*.jpg binary
*.bundle binary
*.db binary
